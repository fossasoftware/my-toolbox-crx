{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "version": "5.2.1",
  "icons": {
    "128": "favicon/my-toolbox-128px.png",
    "48": "favicon/my-toolbox-48px.png",
    "16": "favicon/my-toolbox-16px.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "favicon/my-toolbox-16px.png",
      "48": "favicon/my-toolbox-48px.png"
     }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [ "_locales/en/messages.json", "_locales/uk/messages.json" ],
      "matches": [ "<all_urls>" ]
    },
    {
      "resources": [ "fonts/*.woff", "fonts/*.woff2" ],
      "matches": [ "<all_urls>" ]
    },
    {
      "resources": [ "data/defaultSettings.json" ],
      "matches": [ "<all_urls>" ]
    },
    {
      "resources": ["libs/*.mjs", "libs/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.atlassian.net/*"],
      "js": [
        "features/shared/rule-worker-runtime.js",
        "features/status-colorizer/status-colorizer-logic.js",
        "features/status-colorizer/status-colorizer-worker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.atlassian.net/*"],
      "js": [
        "features/shared/rule-worker-runtime.js",
        "features/row-highlighter/row-highlighter-logic.js",
        "features/row-highlighter/row-highlighter-worker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.atlassian.net/*"],
      "js": [
        "features/shared/rule-worker-runtime.js",
        "features/security-level-customiser/security-level-customiser-constants.js",
        "features/security-level-customiser/security-level-customiser-issue-key.js",
        "features/security-level-customiser/security-level-customiser-preferences.js",
        "features/security-level-customiser/security-level-customiser-store.js",
        "features/security-level-customiser/security-level-customiser-style.js",
        "features/security-level-customiser/security-level-customiser-dom.js",
        "features/security-level-customiser/security-level-customiser-events.js",
        "features/security-level-customiser/security-level-customiser-observers.js",
        "features/security-level-customiser/security-level-customiser-worker.js"
      ],
      "run_at": "document_start"
    }
  ],
   "author": "Vitalii Kopach"
}

{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "version": "4.3.3",
  "icons": {
    "128": "icons/sc-toolbox-128px.png",
    "48": "icons/sc-toolbox-48px.png",
    "16": "icons/sc-toolbox-16px.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/sc-toolbox-16px.png",
      "48": "icons/sc-toolbox-48px.png"
     }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [ "_locales/en/messages.json", "_locales/uk/messages.json" ],
      "matches": [ "<all_urls>" ]
    },
    {
      "resources": [ "fonts/*.woff", "fonts/*.woff2" ],
      "matches": [ "<all_urls>" ]
    },
    {
      "resources": [ "data/defaultSettings.json" ],
      "matches": [ "<all_urls>" ]
    },
    {
      "resources": ["libs/*.mjs", "libs/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.atlassian.net/*"],
      "js": ["features/colorizer/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.atlassian.net/*"],
      "js": ["features/row-highlighter/content.js"],
      "run_at": "document_idle"
    }
  ],
   "author": "Vitalii Kopach"
}

